# Restaurant Ordering Assistant - Environment Configuration
# Copy this file to .env and fill in your values
# NEVER commit .env to version control!

# ===========================================
# GOOGLE GEMINI API
# ===========================================
# Get your API key from: https://makersuite.google.com/app/apikey
GOOGLE_API_KEY=your_gemini_api_key_here

# Optional: override Gemini models (gemini-1.5-* are retired)
# GEMINI_MODEL_FLASH=gemini-2.5-flash
# GEMINI_MODEL_PRO=gemini-2.5-pro

# ===========================================
# EMAIL CONFIGURATION
# ===========================================
# Use a dedicated email for receiving vendor price lists
# For Gmail: use an App Password (https://myaccount.google.com/apppasswords)
EMAIL_USER=orders@yourrestaurant.com
EMAIL_PASS=your_email_app_password
EMAIL_IMAP_SERVER=imap.gmail.com

# ===========================================
# VENDOR SITES (no credentials stored)
# ===========================================
# Vendor login is done manually via browser session refresh:
#   python workers/web_scraper.py --refresh sysco
#   python workers/web_scraper.py --refresh usfoods
SYSCO_URL=https://shop.sysco.com
USFOODS_URL=https://www.usfoods.com

# ===========================================
# APPLICATION SETTINGS
# ===========================================
# Database path (relative to project root)
DATABASE_PATH=data/restaurant_data.db

# Preferences file path
PREFERENCES_PATH=data/preferences.txt

# Session storage directory
SESSIONS_PATH=data/sessions

# Temp directory for processing attachments
TEMP_PATH=data/temp

# ===========================================
# SCHEDULING
# ===========================================
# Email check interval in hours
EMAIL_CHECK_INTERVAL=8

# Weekly scrape day (0=Monday, 6=Sunday)
SCRAPE_DAY=0
SCRAPE_HOUR=4

# Pause between scraped items, in seconds (be polite to vendor sites)
SCRAPE_DELAY_SECS=2

# ===========================================
# SECURITY
# ===========================================
# When set, every page of the app requires this password.
# Strongly recommended if the app is reachable beyond localhost.
APP_PASSWORD=

# Restaurant Ordering Assistant — bootstrap environment (Phase A, issue #50)
#
# As of Phase A this file is BOOTSTRAP ONLY. Everything an operator or
# admin changes lives in the app itself, under Settings → 🔑 Configuration
# (admin password required), stored in the local database and effective on
# the next page run — no restart. The app must never need a file edit
# after install.
#
# Only two things belong here: what is needed to boot far enough to read
# the rest. NEVER commit .env to version control.

# ===========================================
# BOOTSTRAP
# ===========================================
# Where the SQLite database lives (relative to project root).
DATABASE_PATH=data/restaurant_data.db

# Optional one-time admin password. On first boot the app adopts it as
# the admin password and ignores it ever after; without it, first boot
# shows the guided setup page where both passwords (and the API key)
# can be set in the app.
INITIAL_ADMIN_PASSWORD=

# ===========================================
# EVERYTHING ELSE LIVES IN THE APP
# ===========================================
# The following moved into the settings table behind the admin password
# (Settings → 🔑 Configuration): Gemini API key and models, mailbox user /
# password / IMAP host / check interval, scrape day / hour / delay,
# trend / spike / deal thresholds, vendor email domains and portal URLs,
# and both passwords.
#
# Security note (stated plainly, per docs/SPEC.md): configuration now sits
# in the local SQLite file rather than this .env file. On a single-tenant
# restaurant box that is roughly equivalent exposure — anyone with
# filesystem access reads either. The gain is that the admin UI can write
# these values, not that they are safer. The app is secured by its two
# passwords over trusted LAN wifi; the database file itself is chmod 0600.
